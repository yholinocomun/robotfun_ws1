<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robotfun_bringup</name>
  <version>0.2.0</version>
  <description>
    Composition root del brazo RobotFun: launch integradores (sim / gui /
    hardware, con una única fuente de /joint_states) y documentación de
    arquitectura y calibración.
  </description>
  <maintainer email="yholicomun@gmail.com">yholi</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>robotfun_description</exec_depend>
  <exec_depend>robotfun_kinematics</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
