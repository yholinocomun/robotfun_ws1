<?xml version="1.0"?>
<!-- Materiales compartidos por los modelos primitivo y de meshes. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <material name="black"><color rgba="0.10 0.10 0.10 1.0"/></material>
  <material name="grey"><color rgba="0.50 0.50 0.50 1.0"/></material>
  <material name="white_grey"><color rgba="0.80 0.80 0.80 1.0"/></material>
  <material name="red"><color rgba="0.85 0.20 0.20 1.0"/></material>
  <material name="green"><color rgba="0.20 0.70 0.30 1.0"/></material>
  <material name="blue"><color rgba="0.20 0.40 0.85 1.0"/></material>
</robot>
